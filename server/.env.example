# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser
ALLOWED_ORIGINS=https://keloar.com,https://www.keloar.com
# Secret key the site/admin form must send in the "x-admin-key" header
# to trigger a manual (re)generation. Generate a long random value.
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Goldenott reseller API ---
# Base URL for the Goldenott API (Swagger doc: https://goldenott.net/docs).
GOLDENOTT_API_BASE_URL=https://goldenott.net/api
# Token generated from your Goldenott dashboard, sent as the X-API-Key header.
GOLDENOTT_API_KEY=your-goldenott-reseller-api-key

# Maps each site plan (essentiel/premium/famille, matching the "packageId"
# sent by the order form) to the Goldenott IDs required by POST /v1/lines.
# Find package_id via GET /v1/packages in your dashboard; template_id,
# dns_domain_id and tv_domain_id come from the corresponding sections of
# your Goldenott dashboard (Templates / Domains).
GOLDENOTT_PACKAGE_MAP={"essentiel":{"package_id":1,"template_id":1,"dns_domain_id":1,"tv_domain_id":1,"max_connections":1},"premium":{"package_id":2,"template_id":1,"dns_domain_id":1,"tv_domain_id":1,"max_connections":3},"famille":{"package_id":3,"template_id":1,"dns_domain_id":1,"tv_domain_id":1,"max_connections":6}}

# --- WhatsApp Cloud API (Meta) ---
# From Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v20.0
# Name of the approved WhatsApp message template used to deliver
# credentials to customers who haven't messaged you in the last 24h.
# Create/approve it in Meta Business Manager > WhatsApp Manager > Message Templates.
WHATSAPP_TEMPLATE_NAME=iptv_credentials_delivery
WHATSAPP_TEMPLATE_LANG=fr
