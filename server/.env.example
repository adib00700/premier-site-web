# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Secret key you must send in the "x-admin-key" header to call the manual
# admin endpoints (Postman/curl, not a browser). Generate a long random value.
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Goldenott reseller API ---
# Base URL for the Goldenott API (Swagger doc: https://goldenott.net/docs).
GOLDENOTT_API_BASE_URL=https://goldenott.net/api
# Token generated from your Goldenott dashboard, sent as the X-API-Key header.
GOLDENOTT_API_KEY=your-goldenott-reseller-api-key

# IDs required by POST /v1/lines for your free 24h trial package. Find
# package_id via GET /v1/packages in your dashboard; template_id,
# dns_domain_id and tv_domain_id come from the corresponding sections of
# your Goldenott dashboard (Templates / Domains).
GOLDENOTT_TRIAL_PACKAGE_ID=
GOLDENOTT_TRIAL_TEMPLATE_ID=
GOLDENOTT_TRIAL_DNS_DOMAIN_ID=
GOLDENOTT_TRIAL_TV_DOMAIN_ID=
GOLDENOTT_TRIAL_MAX_CONNECTIONS=1

# --- WhatsApp Cloud API (Meta) ---
# From Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v20.0
# Name of the approved WhatsApp message template, only used by the manual
# admin/generate endpoint (starting a conversation with no active 24h window).
# Create/approve it in Meta Business Manager > WhatsApp Manager > Message Templates.
WHATSAPP_TEMPLATE_NAME=iptv_trial_delivery
WHATSAPP_TEMPLATE_LANG=fr

# --- Incoming WhatsApp webhook ---
# Any string you invent; enter the exact same value in Meta's webhook
# configuration screen (Verify token field).
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# App secret from Meta for Developers > your app > Settings > Basic.
# Used to verify that incoming webhook calls really come from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Comma-separated, case-insensitive keywords that trigger an automatic
# trial reply. Any other incoming message is ignored (left for you to
# answer manually).
WHATSAPP_TRIGGER_KEYWORDS=test,essai,trial,demo
