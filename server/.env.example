# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser
ALLOWED_ORIGINS=https://keloar.com,https://www.keloar.com
# Secret key the site/admin form must send in the "x-admin-key" header
# to trigger a manual (re)generation. Generate a long random value.
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Goldenott reseller API ---
# Fill these in once you have the real API doc/credentials from your
# Goldenott reseller panel (Panel > API / Developer section).
GOLDENOTT_API_BASE_URL=https://goldenott.net/api
GOLDENOTT_API_KEY=your-goldenott-reseller-api-key
# Some panels use username/password instead of a single API key -
# leave blank if not needed.
GOLDENOTT_RESELLER_USERNAME=
GOLDENOTT_RESELLER_PASSWORD=
# Default package/bouquet id to assign on new lines, if required by the API.
GOLDENOTT_DEFAULT_PACKAGE_ID=

# --- WhatsApp Cloud API (Meta) ---
# From Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v20.0
# Name of the approved WhatsApp message template used to deliver
# credentials to customers who haven't messaged you in the last 24h.
# Create/approve it in Meta Business Manager > WhatsApp Manager > Message Templates.
WHATSAPP_TEMPLATE_NAME=iptv_credentials_delivery
WHATSAPP_TEMPLATE_LANG=fr
